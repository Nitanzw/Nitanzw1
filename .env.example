# ── Base de datos ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://oktienda:oktienda@localhost:5432/oktienda?schema=public"

# ── Sesiones ───────────────────────────────────────────────────────────────
# Genera una con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ── Sitio ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Imágenes ───────────────────────────────────────────────────────────────
# "local" guarda en public/uploads (desarrollo o un único servidor con disco).
# "s3" usa cualquier servicio compatible con S3: AWS S3, Cloudflare R2, MinIO…
STORAGE_DRIVER="local"
# S3_BUCKET="oktienda"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # omitir en AWS S3
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.oktienda.cl"                        # dominio público del bucket
# S3_FORCE_PATH_STYLE="false"                                    # "true" con MinIO

# ── Correo ─────────────────────────────────────────────────────────────────
# "console" escribe el correo en el log (desarrollo, sin credenciales).
# "smtp" usa un servidor SMTP; "resend" usa la API de Resend.
MAIL_DRIVER="console"
MAIL_FROM="oktienda.cl <no-reply@oktienda.cl>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# RESEND_API_KEY=""

# ── Notificaciones push (app instalable) ───────────────────────────────────
# Genera el par una sola vez con:  npx web-push generate-vapid-keys
# Sin estas claves el sitio funciona igual, pero sin notificaciones push.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:contacto@oktienda.cl"

# ── Errores en producción ──────────────────────────────────────────────────
# Opcional: además del log, manda un aviso acá cuando algo falla (Slack,
# Discord o cualquier endpoint que reciba {"text": "..."}).
# ERROR_WEBHOOK_URL=""

# ── SMS (verificación de teléfono) ─────────────────────────────────────────
# "console" escribe el código en el log; "twilio" lo envía de verdad (con costo).
SMS_DRIVER="console"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+1..."

# ── Tareas programadas ─────────────────────────────────────────────────────
# Protege las rutas /api/cron/*. Ver el README para la frecuencia de cada una.
#   curl -H "Authorization: Bearer $CRON_SECRET" https://oktienda.cl/api/cron/subastas
CRON_SECRET=""

# ── Cuenta de administración creada por el seed ────────────────────────────
# SEED_ADMIN_EMAIL="admin@oktienda.cl"
# SEED_ADMIN_PASSWORD=""

# ── Funcionalidades ────────────────────────────────────────────────────────
# Destacados pagados. Apagados mientras oktienda.cl sea solo un marketplace de
# contactos: el código queda completo, solo deja de ofrecerse. Enciéndelos con
# "on" cuando quieras cobrar (y configura PAYMENT_PROVIDER más abajo).
FEATURE_PAYMENTS="off"
# Calificaciones entre usuarios. Encendidas por defecto.
FEATURE_REVIEWS="on"
# Subastas: publicar a remate y ofertar. Sin pagos: al cerrar, el sistema pone
# en contacto al vendedor con el ganador.
FEATURE_AUCTIONS="on"

# ── Pagos (planes de destacado; solo con FEATURE_PAYMENTS="on") ─────────────
# "dev" aprueba el pago sin cobrar: solo para desarrollo, nunca en producción.
# "mercadopago" crea un cobro real y acredita vía webhook.
PAYMENT_PROVIDER="dev"
# MP_ACCESS_TOKEN=""
