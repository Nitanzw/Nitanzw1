// oktienda.cl — esquema de datos
// Base de clasificados multi-vertical (general, vehículos, propiedades, servicios, empleos).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Vertical {
  GENERAL
  VEHICLES
  REAL_ESTATE
  SERVICES
  JOBS
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  SOLD
}

enum PriceType {
  FIXED
  NEGOTIABLE
  FREE
  ON_REQUEST
}

enum Currency {
  CLP
  UF
  USD
}

enum Condition {
  NEW
  USED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuctionStatus {
  ACTIVE
  /// Cerrada con ganador: la oferta más alta alcanzó la reserva (o no había).
  WON
  /// Cerrada sin ofertas.
  NO_BIDS
  /// Hubo ofertas, pero ninguna alcanzó el precio de reserva.
  RESERVE_NOT_MET
  /// El vendedor la canceló antes del cierre.
  CANCELLED
}

/// Rol de quien escribe la calificación en ese trato.
enum ReviewRole {
  BUYER
  SELLER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  bio           String?
  role          Role      @default(USER)
  emailVerified DateTime?
  /// Cuenta suspendida por moderación. Un usuario bloqueado no puede iniciar
  /// sesión ni operar, y sus avisos dejan de mostrarse.
  blockedAt     DateTime?
  blockedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings              Listing[]
  favorites             Favorite[]
  savedSearches         SavedSearch[]
  sentMessages          Message[]      @relation("MessageSender")
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  reports               Report[]
  payments              Payment[]
  tokens                Token[]
  bids                  Bid[]          @relation("BidBidder")
  reviewsWritten        Review[]       @relation("ReviewAuthor")
  reviewsReceived       Review[]       @relation("ReviewSubject")

  /// Reputación denormalizada, para no sumar calificaciones en cada listado.
  /// La recalcula src/lib/reputation.ts cada vez que cambia una reseña.
  ratingCount Int @default(0)
  ratingSum   Int @default(0)
}

/// Árbol de categorías. `vertical` decide qué atributos extra pide el formulario.
model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  icon     String?
  position Int        @default(0)
  vertical Vertical   @default(GENERAL)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  listings Listing[]

  @@index([parentId])
}

model Region {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  position Int       @default(0)
  communes Commune[]
}

model Commune {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  regionId String
  region   Region    @relation(fields: [regionId], references: [id])
  listings Listing[]

  @@index([regionId])
}

model Listing {
  id          String        @id @default(cuid())
  slug        String
  title       String
  description String
  price       Int?
  currency    Currency      @default(CLP)
  priceType   PriceType     @default(FIXED)
  condition   Condition?
  status      ListingStatus @default(ACTIVE)

  /// Atributos propios del vertical (kilometraje, dormitorios, etc.).
  /// Validados en la app contra el esquema de la categoría — ver src/lib/verticals.ts
  attributes Json @default("{}")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  communeId  String?
  commune    Commune? @relation(fields: [communeId], references: [id])

  contactPhone    String?
  contactWhatsapp Boolean @default(false)
  allowMessages   Boolean @default(true)

  /// Vector de búsqueda full-text (título + descripción, diccionario español y
  /// sin tildes). Prisma solo declara la columna para que `db push` la conserve;
  /// quien la llena es un trigger de Postgres. Ver prisma/fulltext.ts.
  searchVector Unsupported("tsvector")?

  views         Int       @default(0)
  featuredUntil DateTime?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  images        ListingImage[]
  auction       Auction?
  reviews       Review[]
  payments      Payment[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]

  @@index([searchVector], type: Gin)
  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([communeId, status])
  @@index([userId])
}

model ListingImage {
  id           String  @id @default(cuid())
  listingId    String
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  position     Int     @default(0)

  @@index([listingId])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model SavedSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  /// Query string de /buscar tal cual, sin el "?".
  query  String

  /// Avisar por correo cuando aparezcan avisos nuevos que calcen.
  alerts         Boolean   @default(true)
  /// Hasta dónde ya se avisó, para no repetir avisos en el siguiente envío.
  lastNotifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([alerts])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  reviews   Review[]

  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@index([buyerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Nulo en los mensajes automáticos (cierre de subasta, avisos del sistema).
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  /// Marca los mensajes que escribe oktienda.cl, no una persona.
  system         Boolean      @default(false)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Report {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason     String
  detail     String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([listingId])
  @@index([resolvedAt])
}

/// Pago de un plan de destacado. `planCode` referencia src/lib/plans.ts.
model Payment {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  planCode String
  days     Int
  amount   Int
  currency Currency      @default(CLP)
  status   PaymentStatus @default(PENDING)

  /// Proveedor de pago usado ("dev", "mercadopago", …).
  provider    String
  /// Identificador del pago en el proveedor, para conciliar y evitar duplicados.
  providerRef String? @unique

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([status])
}

/// Token de un solo uso para verificar el correo o restablecer la contraseña.
/// Se guarda hasheado: quien lea la base no puede usarlo.
model Token {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

/// Calificación entre dos personas después de un contacto real.
///
/// Va siempre atada a la conversación que las puso en contacto: sin conversación
/// no hay calificación, y cada participante puede dejar una sola. Es lo que evita
/// que se inventen reseñas para inflar (o hundir) la reputación de alguien.
model Review {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  authorId  String
  author    User       @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User       @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  role      ReviewRole

  /// De 1 a 5 estrellas.
  rating   Int
  comment  String?
  /// Si el trato se concretó. Una mala nota sin trato pesa distinto que una con trato.
  dealDone Boolean @default(true)

  /// Respuesta pública de quien fue calificado. Una sola, para dar derecho a réplica.
  reply     String?
  repliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, authorId])
  @@index([subjectId, createdAt])
  @@index([listingId])
}

/// Subasta de un aviso. Sin pagos: la oferta es un compromiso de palabra y, al
/// cerrar, el sistema pone en contacto al vendedor con el ganador. Lo que
/// sostiene el compromiso es la reputación, no un depósito.
model Auction {
  id        String  @id @default(cuid())
  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Desde cuánto parten las ofertas.
  startPrice   Int
  /// Cuánto hay que superar a la oferta más alta.
  minIncrement Int  @default(1000)
  /// Precio mínimo que acepta el vendedor. Oculto para quienes ofertan: solo se
  /// muestra si ya se alcanzó o no. Sin reserva, gana la oferta más alta.
  reservePrice Int?

  endsAt           DateTime
  /// Cierre original, para poder mostrar que la subasta se extendió.
  originalEndsAt   DateTime
  /// Ventana anti-francotirador: una oferta dentro de estos minutos finales
  /// corre el cierre otro tanto, para que nadie gane por ofertar en el segundo 59.
  extensionMinutes Int      @default(5)

  status                AuctionStatus @default(ACTIVE)
  closedAt              DateTime?
  /// Cuándo se avisó a quienes ofertaron que el cierre estaba encima, para no
  /// mandarles el mismo correo en cada corrida del cron.
  closingSoonNotifiedAt DateTime?
  /// Ganador, una vez cerrada.
  winnerId              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids Bid[]

  @@index([status, endsAt])
}

/// Oferta de una subasta. Nunca se borran: el historial es parte de la
/// transparencia de la subasta.
model Bid {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User    @relation("BidBidder", fields: [bidderId], references: [id], onDelete: Cascade)

  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, amount])
  @@index([bidderId])
}
