// oktienda.cl — esquema de datos
// Base de clasificados multi-vertical (general, vehículos, propiedades, servicios, empleos).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Vertical {
  GENERAL
  VEHICLES
  REAL_ESTATE
  SERVICES
  JOBS
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  SOLD
}

enum PriceType {
  FIXED
  NEGOTIABLE
  FREE
  ON_REQUEST
}

enum Currency {
  CLP
  UF
  USD
}

enum Condition {
  NEW
  USED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  bio           String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings              Listing[]
  favorites             Favorite[]
  savedSearches         SavedSearch[]
  sentMessages          Message[]      @relation("MessageSender")
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  reports               Report[]
  payments              Payment[]
}

/// Árbol de categorías. `vertical` decide qué atributos extra pide el formulario.
model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  icon     String?
  position Int        @default(0)
  vertical Vertical   @default(GENERAL)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  listings Listing[]

  @@index([parentId])
}

model Region {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  position Int       @default(0)
  communes Commune[]
}

model Commune {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  regionId String
  region   Region    @relation(fields: [regionId], references: [id])
  listings Listing[]

  @@index([regionId])
}

model Listing {
  id          String        @id @default(cuid())
  slug        String
  title       String
  description String
  price       Int?
  currency    Currency      @default(CLP)
  priceType   PriceType     @default(FIXED)
  condition   Condition?
  status      ListingStatus @default(ACTIVE)

  /// Atributos propios del vertical (kilometraje, dormitorios, etc.).
  /// Validados en la app contra el esquema de la categoría — ver src/lib/verticals.ts
  attributes Json @default("{}")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  communeId  String?
  commune    Commune? @relation(fields: [communeId], references: [id])

  contactPhone    String?
  contactWhatsapp Boolean @default(false)
  allowMessages   Boolean @default(true)

  views         Int       @default(0)
  featuredUntil DateTime?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  images        ListingImage[]
  payments      Payment[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([communeId, status])
  @@index([userId])
}

model ListingImage {
  id           String  @id @default(cuid())
  listingId    String
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  position     Int     @default(0)

  @@index([listingId])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@index([buyerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Report {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([listingId])
}

/// Pago de un plan de destacado. `planCode` referencia src/lib/plans.ts.
model Payment {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  planCode String
  days     Int
  amount   Int
  currency Currency      @default(CLP)
  status   PaymentStatus @default(PENDING)

  /// Proveedor de pago usado ("dev", "mercadopago", …).
  provider    String
  /// Identificador del pago en el proveedor, para conciliar y evitar duplicados.
  providerRef String? @unique

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([status])
}
